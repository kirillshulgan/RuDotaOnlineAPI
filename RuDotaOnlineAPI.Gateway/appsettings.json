{
  "Observability": {
    "ServiceName": "gateway"
  },
  "Jwt": {
    "Issuer": "https://rudotaonline.local",
    "Audience": "rudotaonline-api",
    "JwksUri": "http://identity-api:8080/.well-known/jwks.json"
  },
  "RateLimiting": {
    "AnonymousSlidingWindow": {
      "PermitLimit": 60,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6,
      "QueueLimit": 0
    },
    "AuthenticatedSlidingWindow": {
      "PermitLimit": 300,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6,
      "QueueLimit": 10
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-public": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "AllowAnonymous",
        "RateLimiterPolicy": "anonymous-sliding",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "identity-authorized": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "Authenticated",
        "RateLimiterPolicy": "authenticated-sliding",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        }
      },
      "openapi-identity": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "AllowAnonymous",
        "Match": {
          "Path": "/openapi/identity/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/openapi/identity" }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-api": {
            "Address": "http://identity-api:8080"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Yarp": "Warning"
      }
    }
  }
}