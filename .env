# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=developer
POSTGRES_PASSWORD=1111

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=1111

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=developer
RABBITMQ_PASSWORD=1111

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=1111

# ── JWT RSA Keys ──────────────────────────────────────────────────────────────
# Генерация:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem
#
# Вставить содержимое файлов ниже в одну строку с \n:
#   awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' private.pem
JWT_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# ── Steam ─────────────────────────────────────────────────────────────────────
STEAM_API_KEY=37915D68C79A64F1B804ECA659726858

# ── Gateway ───────────────────────────────────────────────────────────────────
GATEWAY_EXTERNAL_URL=http://localhost:5000