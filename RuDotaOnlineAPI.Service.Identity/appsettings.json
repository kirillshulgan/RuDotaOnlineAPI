{
  "Observability": {
    "ServiceName": "identity-api"
  },
  "Jwt": {
    "Issuer": "https://rudotaonline.local",
    "Audience": "rudotaonline-api",
    "AccessTokenTtlMinutes": 15,
    "RefreshTokenTtlDays": 30
  },
  "Steam": {
    "CallbackUrl": "http://localhost:5000/api/v1/auth/steam/callback"
  },
  "Cache": {
    "RefreshTokenPrefix": "rt"
  },
  "RabbitMq": {
    "Host": "localhost",
    "VirtualHost": "myapp",
    "Username": "myapp",
    "Password": "myapp_dev_rabbit"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  }
}